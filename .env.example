# Copy to .env and fill in. NEVER commit .env.
LOC_DATA_DIR=./data
LOC_ASR_PROVIDER=mock            # mock | whisper
LOC_TRANSLATOR_PROVIDER=mock     # mock | gemini
GEMINI_API_KEY=your-key-here     # only needed when LOC_TRANSLATOR_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash    # verify the current model name in Google's docs
LOC_WHISPER_MODEL=small
LOC_MAX_UPLOAD_MB=200
LOC_MAX_DURATION_S=600
LOC_MAX_TARGET_LANGUAGES=10
LOC_MAX_STAGE_ATTEMPTS=3
LOC_API_KEY=                     # if set, clients must send X-API-Key
LOC_LOG_LEVEL=INFO
